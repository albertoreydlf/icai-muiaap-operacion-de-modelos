{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Códigos estables: el cliente programa contra ellos, no contra el texto.",
        "enum": [
          "invalid_json",
          "validation_error",
          "not_found",
          "method_not_allowed",
          "http_error",
          "model_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "Descripción estable del error.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo presente en errores de validación.",
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Sobre común de todas las respuestas de error (contrato de S7).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "description": "Un campo del cuerpo que incumple el contrato.",
        "properties": {
          "field": {
            "examples": [
              "features.alcohol"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Input should be a valid number"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado del servicio y del modelo cargado.",
        "properties": {
          "model_status": {
            "const": "ready",
            "title": "Model Status",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "model_status",
          "model_version",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Prediction": {
        "description": "Predicción pública: no incluye puntuaciones internas del modelo.",
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "preprocessing_version": {
            "title": "Preprocessing Version",
            "type": "string"
          },
          "quality_band": {
            "$ref": "#/components/schemas/QualityBand"
          }
        },
        "required": [
          "quality_band",
          "confidence",
          "model_version",
          "preprocessing_version"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "PredictionRequest": {
        "additionalProperties": false,
        "description": "Cuerpo de `POST /v1/predictions`.",
        "properties": {
          "features": {
            "$ref": "#/components/schemas/WineFeatures"
          }
        },
        "required": [
          "features"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "Respuesta de `POST /v1/predictions`.",
        "properties": {
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "served_at": {
            "title": "Served At",
            "type": "string"
          }
        },
        "required": [
          "prediction",
          "request_id",
          "served_at"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "QualityBand": {
        "description": "Bandas de calidad que entiende el consumidor.",
        "enum": [
          "needs_review",
          "acceptable",
          "excellent"
        ],
        "title": "QualityBand",
        "type": "string"
      },
      "WineFeatures": {
        "additionalProperties": false,
        "description": "Once variables fisicoquímicas de un vino tinto, con rangos inclusivos.",
        "properties": {
          "alcohol": {
            "description": "Alcohol (% vol.).",
            "maximum": 20.0,
            "minimum": 5.0,
            "title": "Alcohol",
            "type": "number"
          },
          "chlorides": {
            "description": "Cloruros (g/L de cloruro sódico).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Chlorides",
            "type": "number"
          },
          "citric_acid": {
            "description": "Ácido cítrico (g/L).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Citric Acid",
            "type": "number"
          },
          "density": {
            "description": "Densidad (g/cm³).",
            "maximum": 1.01,
            "minimum": 0.98,
            "title": "Density",
            "type": "number"
          },
          "fixed_acidity": {
            "description": "Acidez fija (g/L de ácido tartárico).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Fixed Acidity",
            "type": "number"
          },
          "free_sulfur_dioxide": {
            "description": "Dióxido de azufre libre (mg/L).",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Free Sulfur Dioxide",
            "type": "number"
          },
          "ph": {
            "description": "pH (sin unidad).",
            "maximum": 4.5,
            "minimum": 2.5,
            "title": "Ph",
            "type": "number"
          },
          "residual_sugar": {
            "description": "Azúcar residual (g/L).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Residual Sugar",
            "type": "number"
          },
          "sulphates": {
            "description": "Sulfatos (g/L de sulfato potásico).",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Sulphates",
            "type": "number"
          },
          "total_sulfur_dioxide": {
            "description": "Dióxido de azufre total (mg/L).",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Total Sulfur Dioxide",
            "type": "number"
          },
          "volatile_acidity": {
            "description": "Acidez volátil (g/L de ácido acético).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Volatile Acidity",
            "type": "number"
          }
        },
        "required": [
          "fixed_acidity",
          "volatile_acidity",
          "citric_acid",
          "residual_sugar",
          "chlorides",
          "free_sulfur_dioxide",
          "total_sulfur_dioxide",
          "density",
          "ph",
          "sulphates",
          "alcohol"
        ],
        "title": "WineFeatures",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nAPI de ejemplo para predecir la calidad de un vino tinto a partir de sus\nvariables fisicoquímicas.\n\n**request_id.** Cada respuesta lleva un `request_id` en el cuerpo y en la\ncabecera `X-Request-Id`. Se usa para localizar una petición en los logs.\n\n**Errores.** Todos los errores tienen la misma forma:\n`{\"error\": {\"code\", \"message\", \"fields\"}, \"request_id\"}`. Programa contra\n`code`, que es estable, y no contra `message`. `fields` solo aparece en los\nerrores de validación.\n",
    "summary": "Predice la banda de calidad de un vino tinto.",
    "title": "Wine Quality API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Indica si el servicio responde y si el modelo está cargado.\n\nÚsalo como comprobación de salud (por ejemplo antes de enviar tráfico).\nUn 503 significa que el servicio vive pero el modelo todavía no está listo.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "El servicio y el modelo están listos."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Modelo no disponible."
          }
        },
        "summary": "Comprobar el estado del servicio",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/predictions": {
      "post": {
        "description": "Predice la banda de calidad de un vino a partir de sus once variables.\n\nEnvía las once variables fisicoquímicas dentro de `features`, cada una dentro\nde su rango (los límites valen). La confianza va entre 0 y 1 con dos\ndecimales. Si el JSON está mal formado devuelve 400, si un campo incumple el\ncontrato devuelve 422 y si el modelo no está listo devuelve 503.",
        "operationId": "create_prediction_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "alcohol_fuera_de_rango": {
                  "summary": "Alcohol por encima del máximo (422)",
                  "value": {
                    "features": {
                      "alcohol": 25.0,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "alcohol_texto": {
                  "summary": "Alcohol como texto (422)",
                  "value": {
                    "features": {
                      "alcohol": "mucho",
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "valid": {
                  "summary": "Cuerpo válido",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Banda de calidad con su confianza."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El cuerpo no es JSON válido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El cuerpo incumple el contrato."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Modelo no disponible."
          }
        },
        "summary": "Predecir la calidad de un vino tinto",
        "tags": [
          "predictions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Estado del servicio y del modelo.",
      "name": "health"
    },
    {
      "description": "Predicción de la calidad del vino.",
      "name": "predictions"
    }
  ]
}
